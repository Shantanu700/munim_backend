# Public hostname the tunnel/proxy terminates on (no scheme).
PUBLIC_HOST=backend.playernotk.me
# OAuth 2.0 Client ID from Google Cloud Console, used to verify Google ID tokens.
GOOGLE_CLIENT_ID=
# You invent this when creating the webhook in the Razorpay dashboard (Test Mode on).
# Generate with: openssl rand -hex 32
RZP_WEBHOOK_SECRET=
RZP_KEY_ID=
RZP_KEY_SECRET=
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
DATABASE_URL=postgres://munim:munim@db:5432/munim
REDIS_URL=redis://redis:6379/0
# Required by docker/prod/docker-compose.yml
POSTGRES_PASSWORD=

# Ed25519 mandate signing keys. Generate with: python manage.py mandate_keygen
MUNIM_MANDATE_KEYS=

# Fernet keys for the encrypted Merchant columns (Razorpay key id, key secret,
# webhook secret). Comma-separated, NEWEST FIRST: the first encrypts, all of them
# decrypt. Generate with: python manage.py field_keygen
# Without it the app still boots and still reads pre-encryption rows, but it
# refuses to save a Razorpay credential. Lose it and those columns are
# unrecoverable -- every merchant re-enters their keys.
MUNIM_FIELD_ENCRYPTION_KEYS=
